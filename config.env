# ---- Profile A ----
R_VERSION_A=4.4.3
PYTHON_VERSION_A=3.12
JUPYTER_PORT_A=auto
RSTUDIO_PORT_A=auto
VSCODE_PORT_A=auto

# ---- Profile B ----
R_VERSION_B=4.4.3
PYTHON_VERSION_B=3.12
JUPYTER_PORT_B=auto
RSTUDIO_PORT_B=auto
VSCODE_PORT_B=auto

# ---- Lite reference image (prebuilt into the baked shared store) ----
# The R/Python versions the lightweight image (ds-env-lite-r<R>-py<PY>) is
# prebuilt at by `build.sh lite` / `publish.sh lite`, then loaded into the baked
# read-only shared store by the ansible repo's bake_compute_v2.yml. This is NOT
# a launch profile — deliberately kept out of the R_VERSION_<X> namespace so
# `build.sh all` and the multi-tenant canonical-image transfer never pick it up.
# Users enable a lightweight profile per-profile via LIGHTWEIGHT_<X>=true in
# config.local.env; one at these versions reuses the prebuilt image (no build).
LITE_REF_R_VERSION=4.4.3
LITE_REF_PYTHON_VERSION=3.12

# ---- Shared config ----
WORK_DIR=~/workdir
WORK_MOUNT=/home/workdir

# ---- Packages ----
PACKAGES_DIR=~/packages

# Extra apt system libs are machine-local: set APT_PACKAGES in an untracked
# config.local.env (copy from config.local.env.example), NOT here. That file is
# sourced after this one, so each machine carries its own apt list without
# committing it to the repo. Prefer conda-forge (micromamba install -n denv)
# when a build exists; bake a stable list into the Containerfile apt layer.

# ---- Memory ----
# Max memory per service container (podman --memory). "auto" = system RAM
# minus 2G host headroom, resolved at launch. Lower it per-launch with
# `rstudio -m 16G` (ansible wrapper) or `./run.sh a rstudio --memory 16G`,
# or per-machine in config.local.env. Requests above total-2G are capped
# (with a message) — the limit can never exceed it.
CONTAINER_MEMORY=auto

# ---- GPU ----
# Set to true on hosts with NVIDIA GPU + nvidia-container-toolkit + a CDI spec at
# /etc/cdi/nvidia.yaml. The image is GPU-capable regardless; this flag only
# controls whether run.sh passes --device nvidia.com/gpu=all to podman.
GPU_ENABLED=false

# ---- GCP (optional) ----
# Relative paths resolve against $CALLER_PWD if set, otherwise $PWD at run.sh
# invocation time.
GCP_SERVICE_ACCOUNT_KEY=./claude-default-sa-key.json

# Bucket folder access — space-separated "gs://bucket/prefix:ro|rw" entries.
# Paths not listed here are not exposed to containers (no access).
# Per-human prefix derived from the calling user: run.sh runs as the AI user
# (e.g. mrajai via the auto-redirect), so ${USER%ai} strips the suffix back
# to the human's name (mraj, emacosko, ...). Override in config.local.env.
GCP_BUCKET_ACCESS="gs://mlab-ai-readable/${USER%ai}:ro gs://mlab-ai-writable/${USER%ai}:rw"

# Auto-derived from GCP_SERVICE_ACCOUNT_KEY by run.sh. Override here only if needed:
# GCP_VOLUMES="-v /custom/path/key.json:/run/secrets/gcp-key.json:ro,Z"
# GCP_ENV="-e GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json"
